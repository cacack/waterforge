{
  "name": "waterforge",
  "private": true,
  "version": "1.13.0",
  "type": "module",
  "description": "Clone bottled mineral waters from distilled (or known-source) water and food-grade salts.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "lint": "eslint . && prettier --check . && node scripts/check-shadcn-data-attrs.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.14.0",
    "marked": "^18.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.10.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.66.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "bits-ui": "^2.20.6",
    "clsx": "^2.1.1",
    "svelte": "^5.57.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "minimatch@^10": "^11.0.5",
    "glob@^11": "^14.0.4"
  }
}
